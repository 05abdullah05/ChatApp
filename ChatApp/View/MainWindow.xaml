<Window x:Class="ChatApp.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChatApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
	<Grid Margin="20">
		<StackPanel>

			<TextBlock Text="Your Name:" FontWeight="Bold"/>
			<TextBox Text="{Binding MyName, Mode=TwoWay}" Margin="0,5,0,15"/>

			<!-- LISTEN PORT -->
			<TextBlock Text="Port to Listen On:" FontWeight="Bold"/>
			<TextBox Text="{Binding ListenPort, Mode=TwoWay}" Margin="0,5,0,10"/>

			<Button Content="Start Listening"
                    Command="{Binding StartListeningCommand}"
                    Margin="0,0,0,20"/>

			<!-- PEER CONNECTION -->
			<TextBlock Text="Peer IP:" FontWeight="Bold"/>
			<TextBox Text="{Binding PeerIP, Mode=TwoWay}" Margin="0,5,0,10"/>

			<TextBlock Text="Peer Port:" FontWeight="Bold"/>
			<TextBox Text="{Binding PeerPort, Mode=TwoWay}" Margin="0,5,0,10"/>

			<Button Content="Send Invite"
                    Command="{Binding ConnectCommand}"
                    Margin="0,10,0,20"/>

			<TextBlock Text="Status:" FontWeight="Bold"/>
			<TextBlock Text="{Binding ConnectionStatus}"
                       FontSize="14"
                       Margin="0,5,0,0"/>

			<TextBox
				Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
				Margin="5"
				ToolTip="Search by name"/>

			<ListBox
				ItemsSource="{Binding Conversations}"
				SelectedItem="{Binding SelectedConversation}"
				Margin="5">

				<ListBox.ItemTemplate>
					<DataTemplate>
						<StackPanel>
							<TextBlock Text="{Binding PeerName}" FontWeight="Bold"/>
							<TextBlock Text="{Binding LastUpdated}" FontSize="10"/>
						</StackPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>




		</StackPanel>
	</Grid>
</Window>



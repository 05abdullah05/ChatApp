<Window x:Class="ChatApp.View.InvitePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Incoming Chat Invitation" Width="300" Height="200">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Incoming invite from:" FontWeight="Bold"/>
            <TextBlock Text="{Binding IncomingName}"
                       FontSize="18"
                       Margin="0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">

                <Button Content="Accept"
                        Margin="10,0"
                        Padding="20,5"
                        Command="{Binding AcceptCommand}"/>

                <Button Content="Reject"
                        Margin="10,0"
                        Padding="20,5"
                        Command="{Binding RejectCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
